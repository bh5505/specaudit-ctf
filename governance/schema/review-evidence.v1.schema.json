{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bh5505/specaudit-ctf/governance/schema/review-evidence.v1.schema.json",
  "title": "specaudit.ctf.governance.review-evidence.v1",
  "description": "Checkout-only attributed review-history for the bounded campaign unit U-GOV.b. It records imported 2026-10-13 attribution (reviewed_on) as historical declarations distinct from the 2026-10-18 import record (recorded_on), sha256-bound evidence files, per-entity/trigger observations, newly executed record checks, explicit unknowns, and limitations. It grants no admission, promotion, shipment, support, custody, or recurring-operation claim; reviewer attribution is evidence, not authentication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "history_id",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "specaudit.ctf.governance.review-evidence.v1"
    },
    "schema_version": {
      "const": 1
    },
    "history_id": {
      "const": "attributed-review-history-v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/definitions/record"
      }
    }
  },
  "definitions": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "date_string": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entity_ref": {
      "type": "string",
      "pattern": "^(module|source|runtime):[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.(md|yaml|json)$"
        },
        "sha256": {
          "$ref": "#/definitions/digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "trigger",
        "basis",
        "checked_via",
        "evidence_ref",
        "observed_on",
        "outcome"
      ],
      "properties": {
        "entity": {
          "$ref": "#/definitions/entity_ref"
        },
        "trigger": {
          "$ref": "#/definitions/nonempty_string"
        },
        "basis": {
          "enum": [
            "historical-declaration",
            "executed-check",
            "unknown"
          ]
        },
        "checked_via": {
          "enum": [
            "checker-rederived-inventory-reconciliation",
            "primary-source-review",
            "architecture-review"
          ]
        },
        "evidence_ref": {
          "$ref": "#/definitions/nonempty_string"
        },
        "observed_on": {
          "$ref": "#/definitions/date_string"
        },
        "outcome": {
          "enum": [
            "reviewed",
            "unknown"
          ]
        }
      }
    },
    "record_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "result",
        "detail"
      ],
      "properties": {
        "check": {
          "$ref": "#/definitions/nonempty_string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "detail": {
          "$ref": "#/definitions/nonempty_string"
        }
      }
    },
    "asserts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrity_ok",
        "coverage_ok",
        "recurring_operation_ok"
      ],
      "properties": {
        "integrity_ok": {
          "type": "boolean"
        },
        "coverage_ok": {
          "type": "boolean"
        },
        "recurring_operation_ok": {
          "type": "boolean"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "reviewed_on",
        "recorded_on",
        "reviewer",
        "inspected_revision",
        "predecessor_digest",
        "evidence",
        "observations",
        "record_checks",
        "unknown_outcomes",
        "limitations",
        "asserts"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "reviewed_on": {
          "$ref": "#/definitions/date_string"
        },
        "recorded_on": {
          "$ref": "#/definitions/date_string"
        },
        "reviewer": {
          "$ref": "#/definitions/nonempty_string"
        },
        "inspected_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "predecessor_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/digest"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/definitions/evidence_binding"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/definitions/observation"
          }
        },
        "record_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/record_check"
          }
        },
        "unknown_outcomes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/nonempty_string"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/nonempty_string"
          }
        },
        "asserts": {
          "$ref": "#/definitions/asserts"
        }
      }
    }
  }
}
