{
  "schema": "specaudit.ctf.capability.manifest.v1",
  "schema_version": 1,
  "capability_id": "fixture.range-observe",
  "tier": "research",
  "kind": "range",
  "tool": {
    "name": "fixture-range",
    "version": "1.0.0"
  },
  "protocols": ["cli-json", "mcp-stdio"],
  "safety_class": "R0",
  "side_effects": ["local-read"],
  "default_off": true,
  "synthetic_only": true,
