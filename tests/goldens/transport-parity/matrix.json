{
  "schema": "specaudit.ctf.transport-parity.v1",
  "description": "Frozen X4-PUB transport-parity fixture matrix. Every case names one logical request; the parity test executes it through both transports (CLI JSON and stdio MCP tools/call) and asserts envelope equivalence modulo wall-clock fields. Frozen fields are host-independent by construction; cases marked equivalence_only assert cross-transport equality without pinning host-dependent values. isError mirrors the CLI exit code (nonzero exit = isError); verdict vocabulary lives in the envelope status (G-24).",
  "normalization": {
    "drop_fields": [
      "started_at",
      "finished_at"
    ],
    "drop_paths": [
      "budget.spent.elapsed_ms"
    ]
  },
  "cases": [
    {
      "id": "list_catalog",
      "kind": "payload",
      "cli": [
        "list"
      ],
      "mcp_tool": "list",
      "mcp_arguments": {},
      "expect": {
        "exit_code": 0,
        "is_error": false
      }
    },
    {
      "id": "describe_agent_wiz",
      "kind": "payload",
      "cli": [
        "describe",
        "agent-wiz"
      ],
      "mcp_tool": "describe",
      "mcp_arguments": {
        "id": "agent-wiz"
      },
      "expect": {
        "exit_code": 0,
        "is_error": false
      }
    },
    {
      "id": "describe_unknown",
      "kind": "domain_error_no_envelope",
      "cli": [
        "describe",
        "no-such-arm"
      ],
      "mcp_tool": "describe",
      "mcp_arguments": {
        "id": "no-such-arm"
      },
      "expect": {
        "exit_code": 2,
        "is_error": true,
        "message_contains": "unknown id"
      }
    },
    {
