    {
      "id": "run_range_auto_discover_equivalence_only",
      "kind": "envelope_equivalence_only",
      "note": "Auto-discovery includes host-dependent installed state, but held curated arms force at least one error row on every host, and error rows count as limited under optional (auto-discovered) semantics, so the document status is degraded everywhere; per-arm rows, limitations, and the range-report digest vary with the host.",
      "cli_module": "extension.range",
      "cli": [],
      "mcp_tool": "run_range",
      "mcp_arguments": {},
      "expect": {
        "is_error": true,
        "envelope": {
          "status": "degraded"
        }
      }
    },
    {
      "id": "contract_invalid_attempt_id",
      "kind": "transport_idiom_divergence",
      "note": "Pre-dispatch contract violations never reach a tool execution on either transport: the CLI exits 2 with stderr only; MCP answers -32602 with no envelope.",
      "cli": [
        "invoke",
        "agent-wiz",
        "list_tools",
        "--attempt-id",
        "not-an-attempt"
      ],
      "cli_expect": {
        "exit_code": 2,
        "stdout_empty": true
      },
      "mcp_tool": "invoke",
      "mcp_arguments": {
        "id": "agent-wiz",
        "action": "list_tools",
        "attempt_id": "not-an-attempt"
      },
      "mcp_expect": {
        "json_rpc_error_code": -32602
      }
    },
    {
      "id": "contract_artifact_dir_requires_attempt_id",
      "kind": "transport_idiom_divergence",
