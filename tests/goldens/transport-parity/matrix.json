      "expect": {
        "exit_code": 0,
        "is_error": false,
        "envelope": {
          "schema": "specaudit.ctf.execution-result.v1",
          "status": "complete",
          "transport_ok": true,
          "capability_id": "agent-wiz.list_tools",
          "limitations": [],
          "artifact_kinds": [
            "policy-report"
          ],
          "artifact_digests": [
            "sha256:e5deb8e08de06a6a33085513da3aadd9153fd35cba614aeb589da36394fc7f92"
          ]
        }
      }
    },
    {
      "id": "invoke_agent_wiz_list_tools_attempt_echo",
      "kind": "envelope",
      "cli": [
        "invoke",
        "agent-wiz",
        "list_tools",
        "--attempt-id",
        "attempt-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "mcp_tool": "invoke",
      "mcp_arguments": {
        "id": "agent-wiz",
        "action": "list_tools",
        "args": {},
        "attempt_id": "attempt-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "exit_code": 0,
        "is_error": false,
        "envelope": {
          "schema": "specaudit.ctf.execution-result.v1",
          "status": "complete",
          "transport_ok": true,
          "capability_id": "agent-wiz.list_tools",
          "attempt_id": "attempt-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "artifact_digests": [
            "sha256:e5deb8e08de06a6a33085513da3aadd9153fd35cba614aeb589da36394fc7f92"
          ]
        }
      }
    },
