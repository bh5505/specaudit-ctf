    {
      "id": "invoke_invalid_args_json_cli_only",
      "kind": "transport_idiom_divergence",
      "note": "A JSON-string arguments body exists only on the CLI; MCP arguments arrive pre-parsed. CLI fail-closes with an invalid-args envelope (exit 2); the MCP shape equivalent (non-object args) is JSON-RPC -32602 with no envelope. Both refuse before dispatch.",
      "cli": [
        "invoke",
        "agent-wiz",
        "list_tools",
        "not-json"
      ],
      "cli_expect": {
        "exit_code": 2,
        "envelope": {
          "schema": "specaudit.ctf.execution-result.v1",
          "status": "failed",
          "transport_ok": false,
          "limitations": [
            "invalid JSON arguments"
          ]
        }
      },
      "mcp_tool": "invoke",
      "mcp_arguments": {
        "id": "agent-wiz",
        "action": "list_tools",
        "args": "not-json"
      },
      "mcp_expect": {
        "json_rpc_error_code": -32602
      }
    },
    {
      "id": "invoke_vvah_list_tools_equivalence_only",
      "kind": "envelope_equivalence_only",
      "note": "Installed state is host-dependent; both transports must agree with each other on the same host without pinning a class.",
      "cli": [
        "invoke",
        "vvah",
        "list_tools"
      ],
      "mcp_tool": "invoke",
      "mcp_arguments": {
        "id": "vvah",
        "action": "list_tools"
      }
    },
