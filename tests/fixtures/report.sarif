{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0-json-schema.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "specaudit-ctf",
          "rules": [
            {
              "id": "demo_pack_t1_exposed",
              "name": "Trust Boundary Violation",
              "shortDescription": {"text": "Detects trust boundary violations"},
              "defaultConfiguration": {"level": "error"}
            },
            {
              "id": "demo_pack_t2_adversarial_validation",
              "name": "Adversarial Validation Bypass",
              "shortDescription": {"text": "Detects bypasses of adversarial validation checks"},
              "defaultConfiguration": {"level": "warning"}
            },
            {
              "id": "demo_pack_t3_evidence_gate",
              "name": "Deterministic Gate Failure",
              "shortDescription": {"text": "Detects failures in deterministic evidence generation gates"},
              "defaultConfiguration": {"level": "error"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "demo_pack_t1_exposed",
          "level": "error",
          "message": {"text": "Trust boundary violation in IAM role assumption"},
          "partialFingerprints": {
            "finding_alias": "demo_pack:demo_pack_t1_exposed:FG-001"
          },
          "properties": {
            "technique": "T1",
            "severity": "high",
            "risk_score": 85,
            "exposure_estimate": 85
          },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "evidence/finding_candidate.csv:1"}}}]
        },
        {
          "ruleId": "demo_pack_t2_adversarial_validation",
          "level": "warning",
          "message": {"text": "Adversarial validation bypass detected"},
          "partialFingerprints": {
            "finding_alias": "demo_pack:demo_pack_t2_adversarial_validation:FG-002"
          },
          "properties": {
            "technique": "T2",
            "severity": "medium",
            "risk_score": 65,
            "exposure_estimate": 65
          },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "evidence/finding_candidate.csv:2"}}}]
        },
        {
          "ruleId": "demo_pack_t3_evidence_gate",
          "level": "error",
          "message": {"text": "Deterministic gate failure in evidence generation"},
          "partialFingerprints": {
            "finding_alias": "demo_pack:demo_pack_t3_evidence_gate:FG-003"
          },
          "properties": {
            "technique": "T3",
            "severity": "high",
            "risk_score": 90,
            "exposure_estimate": 90
          },
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "evidence/finding_candidate.csv:3"}}}]
        }
      ]
    }
  ]
}
