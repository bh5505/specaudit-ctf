{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specaudit-ctf PR97 reader safety register",
  "description": "Closed checkout-only v1 inventory of permanently unverified safety requirements for the 14 PR97 caller-file readers.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "register_revision",
    "scope",
    "surface_anchors",
    "hazards",
    "controls",
    "arms",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "specaudit.ctf.safety.register.v1" },
    "schema_version": { "const": 1 },
    "register_revision": { "const": 1 },
    "scope": { "$ref": "#/definitions/scope" },
    "surface_anchors": { "$ref": "#/definitions/surface_anchors" },
    "hazards": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/hazard" }
    },
    "controls": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/control" }
    },
    "arms": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/arm" }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nonempty_string" }
    }
  },
  "definitions": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "arm_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^R[0-9]{2}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$"
    },
    "python_module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "required": [
        "id",
        "description",
        "repository_complete",
        "safety_complete",
        "arm_count",
        "discovery_action_count",
        "data_action_count"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "pr97-readers" },
        "description": { "$ref": "#/definitions/nonempty_string" },
        "repository_complete": { "const": false },
        "safety_complete": { "const": false },
        "arm_count": { "const": 14 },
        "discovery_action_count": { "const": 14 },
        "data_action_count": { "const": 38 }
      }
    },
    "surface_anchors": {
      "type": "object",
      "required": [
        "governance",
        "coverage",
        "invoke_profiles",
        "policies",
        "reader_runtime"
      ],
      "additionalProperties": false,
      "properties": {
        "governance": { "$ref": "#/definitions/digest" },
        "coverage": { "$ref": "#/definitions/digest" },
        "invoke_profiles": { "$ref": "#/definitions/digest" },
        "policies": { "$ref": "#/definitions/digest" },
        "reader_runtime": { "$ref": "#/definitions/digest" }
      }
    },
    "hazard": {
      "type": "object",
      "required": [
        "id",
        "record_version",
        "category",
        "title",
        "condition",
        "impact",
        "required_control_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HZ-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "record_version": { "const": 1 },
        "category": {
          "type": "string",
          "enum": [
            "filesystem",
            "data",
            "credentials",
            "network",
            "availability",
            "integrity",
            "grading",
            "instruction"
          ]
        },
        "title": { "$ref": "#/definitions/nonempty_string" },
        "condition": { "$ref": "#/definitions/nonempty_string" },
        "impact": { "$ref": "#/definitions/nonempty_string" },
        "required_control_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CTL-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "id",
        "record_version",
        "type",
        "enforcement_owners",
        "objective",
        "verification_requirement",
        "status",
        "evidence_refs",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CTL-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "record_version": { "const": 1 },
        "type": {
          "type": "string",
          "enum": ["preventive", "detective"]
        },
        "enforcement_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "operator-environment",
              "trusted-input-custodian",
              "trusted-validator",
              "independent-supervisor"
            ]
          }
        },
        "objective": { "$ref": "#/definitions/nonempty_string" },
        "verification_requirement": { "$ref": "#/definitions/nonempty_string" },
        "status": { "const": "unverified" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 0,
          "items": { "$ref": "#/definitions/nonempty_string" }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonempty_string" }
        }
      }
    },
    "nullable_positive_integer": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "input_contract": {
      "type": "object",
      "required": [
        "path_argument",
        "input_kind",
        "max_file_bytes",
        "allowed_suffixes",
        "max_directory_entries"
      ],
      "additionalProperties": false,
      "properties": {
        "path_argument": { "$ref": "#/definitions/identifier" },
        "input_kind": {
          "type": "string",
          "enum": ["file", "directory"]
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_suffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        },
        "max_directory_entries": {
          "$ref": "#/definitions/nullable_positive_integer"
        }
      }
    },
    "data_action": {
      "type": "object",
      "required": [
        "capability_id",
        "action",
        "input_keys",
        "path_argument",
        "input_kind"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_id": { "$ref": "#/definitions/capability_id" },
        "action": { "$ref": "#/definitions/identifier" },
        "input_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/identifier" }
        },
        "path_argument": { "$ref": "#/definitions/identifier" },
        "input_kind": {
          "type": "string",
          "enum": ["file", "directory"]
        }
      }
    },
    "arm": {
      "type": "object",
      "required": [
        "record_version",
        "arm_id",
        "source_id",
        "policy_module",
        "state",
        "input_contract",
        "discovery_capability_id",
        "data_actions",
        "hazard_ids",
        "required_control_ids",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "record_version": { "const": 1 },
        "arm_id": { "$ref": "#/definitions/arm_id" },
        "source_id": { "$ref": "#/definitions/source_id" },
        "policy_module": { "$ref": "#/definitions/python_module" },
        "state": { "const": "documented-unverified" },
        "input_contract": { "$ref": "#/definitions/input_contract" },
        "discovery_capability_id": { "$ref": "#/definitions/capability_id" },
        "data_actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/data_action" }
        },
        "hazard_ids": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^HZ-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        },
        "required_control_ids": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CTL-[A-Z0-9]+(-[A-Z0-9]+)*$"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonempty_string" }
        }
      }
    }
  }
}
