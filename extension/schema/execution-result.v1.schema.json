{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specaudit.ctf.execution-result.v1",
  "description": "CLI JSON and stdio MCP encoding of one capability run. transport_ok is informational. Status is complete, degraded, or failed; semantic complete is owned by the parser, not this schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capability_id",
    "tool",
    "scope",
    "safety_class",
    "side_effects",
    "approval_ref",
    "roe_ref",
    "budget",
    "started_at",
    "finished_at",
    "status",
    "transport_ok",
    "artifacts",
    "coverage",
    "cleanup",
    "limitations"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "specaudit.ctf.execution-result.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capability_id": {
      "$ref": "#/definitions/capability_id"
    },
    "tool": {
      "$ref": "#/definitions/tool"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt-[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "touched"],
      "properties": {
        "authorized": { "$ref": "#/definitions/scope_list" },
        "touched": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/scope_item" }
        }
      }
    },
    "safety_class": {
      "$ref": "#/definitions/safety_class"
    },
    "side_effects": {
      "$ref": "#/definitions/side_effects"
    },
    "approval_ref": {
      "$ref": "#/definitions/optional_ref"
    },
    "roe_ref": {
      "$ref": "#/definitions/optional_ref"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserved", "spent"],
      "properties": {
        "reserved": { "$ref": "#/definitions/budget_limit" },
        "spent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["elapsed_ms", "output_bytes", "tool_steps", "spend"],
          "properties": {
            "elapsed_ms": { "type": "integer", "minimum": 0 },
            "output_bytes": { "type": "integer", "minimum": 0 },
            "tool_steps": { "type": "integer", "minimum": 0 },
            "spend": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "started_at": { "$ref": "#/definitions/utc_timestamp" },
    "finished_at": { "$ref": "#/definitions/utc_timestamp" },
    "status": {
      "type": "string",
      "enum": ["complete", "degraded", "failed"],
      "description": "Claimed status. Semantic complete is enforced by the parser, not by this schema."
    },
    "transport_ok": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "complete",
        "skipped",
        "unsupported",
        "failed",
        "required"
      ],
      "properties": {
        "attempted": { "$ref": "#/definitions/id_list" },
        "complete": { "$ref": "#/definitions/id_list" },
        "skipped": { "$ref": "#/definitions/id_list" },
        "unsupported": { "$ref": "#/definitions/id_list" },
        "failed": { "$ref": "#/definitions/id_list" },
        "required": { "$ref": "#/definitions/id_list" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "proof_digest", "residual"],
      "properties": {
        "required": { "type": "boolean" },
        "proof_digest": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/digest" }
          ]
        },
        "residual": { "type": "boolean" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9_]*(-[a-z0-9_]+)*)+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "safety_class": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3"]
    },
    "optional_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "scope_item": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["*", "0.0.0.0/0", "::/0"] }
    },
    "scope_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/scope_item" }
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "none",
          "local-read",
          "local-write",
          "subprocess",
          "network-egress",
          "cloud-read",
          "cloud-mutate"
        ]
      },
      "allOf": [
        {
          "if": { "contains": { "const": "none" } },
          "then": { "maxItems": 1 }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "budget_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_output_bytes", "max_tool_steps", "max_spend"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_tool_steps": { "type": "integer", "minimum": 1 },
        "max_spend": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "kind", "redaction"],
      "properties": {
        "digest": { "$ref": "#/definitions/digest" },
        "kind": { "type": "string", "minLength": 1 },
        "redaction": { "type": "string", "minLength": 1 }
      }
    }
  }
}
