{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specaudit.ctf.source-admission.v3",
  "description": "Closed structural contract for validator-authored, per-attempt admission of exact local source bytes for the opt-in gpohound.policy trusted-observation profile. Runtime verification owns cross-field profile coherence, time ordering/duration, content identity, subject-to-scope equality, and byte-binding semantics. This document is not source governance, rights clearance, execution authority, authenticity proof, effective-access evidence, or physical-custody proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "admission_id",
    "attempt_id",
    "capability_id",
    "arm_id",
    "action",
    "issuer",
    "producer",
    "issued_at",
    "validity",
    "source",
    "subject",
    "scope",
    "custody",
    "evidence_class",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "specaudit.ctf.source-admission.v3" },
    "schema_version": { "type": "integer", "const": 3 },
    "admission_id": {
      "type": "string",
      "pattern": "^source-admission-[0-9a-f]{64}$(?![\\s\\S])"
    },
    "attempt_id": { "$ref": "#/definitions/attempt_id" },
    "capability_id": { "const": "gpohound.policy" },
    "arm_id": { "const": "gpohound" },
    "action": { "const": "policy" },
    "issuer": { "$ref": "#/definitions/issuer" },
    "producer": { "$ref": "#/definitions/producer" },
    "issued_at": { "$ref": "#/definitions/timestamp" },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_before", "not_after"],
      "properties": {
        "not_before": { "$ref": "#/definitions/timestamp" },
        "not_after": { "$ref": "#/definitions/timestamp" }
      }
    },
    "source": { "$ref": "#/definitions/source" },
    "subject": { "$ref": "#/definitions/subject" },
    "scope": { "$ref": "#/definitions/scope" },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "source_assertion",
        "raw_artifact_locator"
      ],
      "properties": {
        "controller": { "$ref": "#/definitions/identifier" },
        "source_assertion": { "const": "validator-held-before-attempt" },
        "raw_artifact_locator": { "$ref": "#/definitions/ref" }
      }
    },
    "evidence_class": { "const": "declared" },
    "limitations": { "$ref": "#/definitions/limitations" }
  },
  "definitions": {
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt-[0-9a-f]{64}$(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000-)(?:(?:[0-9]{4}-(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01]))|(?:[0-9]{4}-(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30))|(?:[0-9]{4}-02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?![\\s\\S])"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,255}$(?![\\s\\S])"
    },
    "policy_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,255}|\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\})$(?![\\s\\S])"
    },
    "ref": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]+$(?![\\s\\S])"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "version": { "$ref": "#/definitions/identifier" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "revision"],
      "properties": {
        "id": { "const": "specaudit-ctf" },
        "version": { "const": "0.1.0" },
        "revision": { "$ref": "#/definitions/identifier" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "schema",
        "timestamp",
        "freshness",
        "logical_locator",
        "authority_ref",
        "raw_artifact"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "revision": { "$ref": "#/definitions/identifier" },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "format"],
          "properties": {
            "id": { "const": "specaudit.ctf.gpohound-policy-evidence-projection.v1" },
            "version": { "type": "integer", "const": 1 },
            "format": { "enum": ["json", "yaml", "yml"] }
          }
        },
        "timestamp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "enum": ["known", "unknown"] },
            "value": {
              "anyOf": [
                { "$ref": "#/definitions/timestamp" },
                { "type": "null" }
              ]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "known" } } },
              "then": { "properties": { "value": { "$ref": "#/definitions/timestamp" } } },
              "else": { "properties": { "value": { "type": "null" } } }
            }
          ]
        },
        "freshness": { "const": "not-assessed" },
        "logical_locator": { "$ref": "#/definitions/ref" },
        "authority_ref": { "$ref": "#/definitions/ref" },
        "raw_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "bytes", "normalized_records_digest"],
          "properties": {
            "digest": { "$ref": "#/definitions/digest" },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "normalized_records_digest": { "$ref": "#/definitions/digest" }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "policy_id"],
      "properties": {
        "kind": { "const": "gpo-policy" },
        "policy_id": { "$ref": "#/definitions/policy_identifier" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier"],
      "properties": {
        "kind": { "const": "gpo-policy-record" },
        "identifier": {
          "type": "string",
          "maxLength": 263,
          "pattern": "^policy:(?:[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,255}|\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\})$(?![\\s\\S])"
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"
      }
    }
  }
}
