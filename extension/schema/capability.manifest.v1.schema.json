{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specaudit.ctf.capability.manifest.v1",
  "description": "One invocable capability (arm action, range fixture, or listing). Survey catalog rows are not manifests. Unknown schema, capability, or tier fails closed with zero dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capability_id",
    "tier",
    "kind",
    "tool",
    "protocols",
    "safety_class",
    "side_effects",
    "default_off",
    "synthetic_only",
    "authorized_scope",
    "approval_ref",
    "roe_ref",
    "budget",
    "cleanup",
    "redaction"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "specaudit.ctf.capability.manifest.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capability_id": {
      "$ref": "#/definitions/capability_id"
    },
    "tier": {
      "type": "string",
      "enum": ["research", "experimental", "maintained", "held"]
    },
    "kind": {
      "type": "string",
      "enum": ["arm", "head", "range", "methodology-only"]
    },
    "tool": {
      "$ref": "#/definitions/tool"
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["cli-json", "mcp-stdio"]
      }
    },
    "safety_class": {
      "$ref": "#/definitions/safety_class"
    },
    "side_effects": {
      "$ref": "#/definitions/side_effects"
    },
    "default_off": {
      "type": "boolean"
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "authorized_scope": {
      "$ref": "#/definitions/scope_list"
    },
    "approval_ref": {
      "$ref": "#/definitions/optional_ref"
    },
    "roe_ref": {
      "$ref": "#/definitions/optional_ref"
    },
    "budget": {
      "$ref": "#/definitions/budget_limit"
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "proof"],
      "properties": {
        "required": { "type": "boolean" },
        "proof": {
          "type": "string",
          "enum": ["none", "artifact-digest"]
        }
      }
    },
    "redaction": {
      "$ref": "#/definitions/redaction"
    }
  },
  "definitions": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9_]*(-[a-z0-9_]+)*)+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safety_class": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3"]
    },
    "optional_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "scope_item": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["*", "0.0.0.0/0", "::/0"] }
    },
    "scope_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/scope_item" }
    },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "none",
          "local-read",
          "local-write",
          "subprocess",
          "network-egress",
          "cloud-read",
          "cloud-mutate"
        ]
      },
      "allOf": [
        {
          "if": { "contains": { "const": "none" } },
          "then": { "maxItems": 1 }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "budget_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_output_bytes", "max_tool_steps", "max_spend"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_tool_steps": { "type": "integer", "minimum": 1 },
        "max_spend": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "env"],
      "properties": {
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "env": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
