{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "specaudit-ctf coverage catalog",
  "description": "Catalog of CTF arm handlers, agent heads, and reference methodology entries.",
  "type": "object",
  "required": [
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Catalog schema version."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "protocols",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Stable kebab-case public product id."
        },
        "kind": {
          "type": "string",
          "enum": [
            "head",
            "arm",
            "methodology-only"
          ],
          "description": "arm = invocable adapter; head = agent or CLI head; methodology-only = reference material."
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "mcp",
              "cli",
              "http",
              "none"
            ]
          },
          "description": "Protocols the row speaks. Use none alone when there is no invocable surface."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "Short public note. Must stay inside the language bar."
        }
      }
    }
  }
}
